\name{print.mst_test}
\alias{print.mst_test}
\title{Print method for pruned-MST test results}
\description{Prints the statistics and permutation p-values of an object returned by \code{\link{mst_test}} or \code{\link{mst_test_dist}}.}
\usage{\method{print}{mst_test}(x, digits = 4, ...)}
\arguments{
\item{x}{an object of class \code{"mst_test"}.}
\item{digits}{number of significant digits.}
\item{...}{ignored.}
}
\value{\code{x}, invisibly.}
\keyword{internal}
